# Base URL of the FastAPI backend. No trailing slash.
#   Local dev:  http://127.0.0.1:8000
#   Production: https://your-service.onrender.com
#
# Required. The app shows a configuration error if this is missing.
# NEXT_PUBLIC_* values are inlined at BUILD time, so changing this on your
# host requires a rebuild to take effect.
NEXT_PUBLIC_API_URL=

# Client-side upload guardrail in megabytes. Must match the backend's limit.
# Optional, defaults to 10.
NEXT_PUBLIC_MAX_FILE_SIZE_MB=10
