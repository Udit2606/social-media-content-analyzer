# Comma-separated list of browser origins allowed to call this API.
# No trailing slashes. Add your Vercel URL for production.
#   Local:      http://localhost:3000
#   Production: https://postora.vercel.app
CORS_ALLOW_ORIGINS=http://localhost:3000

# Maximum accepted upload size in megabytes. Keep in sync with the frontend's
# NEXT_PUBLIC_MAX_FILE_SIZE_MB.
MAX_FILE_SIZE_MB=10

# Hard cap on how many pages of a scanned PDF get rendered and OCR'd.
MAX_OCR_PAGES=10

# Absolute path to the tesseract binary. LEAVE BLANK unless you need it.
#
# Resolution order:
#   1. this variable, if set
#   2. whatever `tesseract` resolves to on PATH  <- the normal case
#   3. standard install locations (/opt/homebrew/bin, /usr/local/bin,
#      /opt/local/bin, /usr/bin)
#
# Only set this when the binary is somewhere unusual, or when the server is
# started with a stripped PATH (launchd, some supervisors and CI runners do
# this, so `tesseract` works in your terminal but not in the server process).
# A wrong value here is logged and ignored, not fatal: PDFs keep working and
# image uploads return a clear 503.
TESSERACT_CMD=

# Tesseract language pack to use.
OCR_LANGUAGE=eng

# -- AI analysis --------------------------------------------------------
#
# A free API key from https://aistudio.google.com/apikey (no credit card
# required). BACKEND ONLY: this value must never be sent to the frontend,
# returned in a response, or committed to git. Leave blank to disable AI
# analysis -- POST /api/analyze then returns 503 AI_UNAVAILABLE, while
# POST /api/upload (extraction only) keeps working normally.
GEMINI_API_KEY=

# Any current Gemini model that supports structured JSON output.
GEMINI_MODEL=gemini-3.6-flash

# Extracted text is truncated to this many characters before being sent to
# the model, to bound cost and latency on very long documents.
AI_MAX_INPUT_CHARS=6000

# Hard deadline, in seconds, for one call to the AI API.
AI_TIMEOUT_SECONDS=30

# Verbose logging. Never enable in production.
DEBUG=false
